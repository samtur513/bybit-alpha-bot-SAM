# ==============================================================================
# BYBIT V5 LIVE EXECUTION GATE: CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# ВАЖНО: Храните этот файл с правами chmod 600 на сервере.
# Никогда не передавайте эти ключи третьим лицам или в чаты.

# 1. API-ключи изолированного СУБАККАУНТА Bybit
# (Чекбокс "Withdrawals" на Bybit ОБЯЗАН быть выключен!)
BYBIT_API_KEY=your_subaccount_api_key_here
BYBIT_API_SECRET=your_subaccount_api_secret_here

# 2. Сеть (false = Mainnet Bybit, true = Testnet)
BYBIT_TESTNET=false

# 3. Главный предохранитель боевого исполнения
# false = Dry-Run (безопасная симуляция с боевыми проверками)
# true  = Боевое исполнение микро-ордеров на субаккаунте
LIVE_TRADING_ENABLED=false

# 4. Аппаратные лимиты риска (Hardware Risk Gates)
LIVE_MAX_NOTIONAL_PER_POS=30.0       # Максимальный размер 1 позиции (потолок $30.00 USDT)
LIVE_MAX_PORTFOLIO_NOTIONAL=60.0     # Максимальная сумма всех открытых позиций ($60.00 USDT)
LIVE_MAX_DAILY_LOSS_USD=10.0         # Суточный рубильник: стоп торговли при убытке -$10 USDT в день
LIVE_MAX_DAILY_LOSS_PCT=5.0          # Суточный рубильник: стоп торговли при убытке -5% в день
LIVE_MAX_LEVERAGE=2.0                # Жесткий потолок кредитного плеча (2.0x)
