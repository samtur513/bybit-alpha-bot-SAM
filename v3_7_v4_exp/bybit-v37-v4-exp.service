[Unit]
Description=Bybit Multi-Alpha v3.7-v4 NewDragon Scalp Lab (Port 8093)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bybit-bot
EnvironmentFile=-/opt/bybit-bot/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/bybit-bot
Environment=PORT_V37_V4_EXP=8093
Environment=PAPER_TRADING=true
Environment=USE_MNT_DISCOUNT=true
Environment=EQUITY_USDT=300.0
ExecStart=/opt/bybit-bot/venv/bin/python /opt/bybit-bot/v3_7_v4_exp/web_dashboard.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
